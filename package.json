{
  "name": "godot-universal-mcp",
  "version": "0.1.0",
  "description": "Universal MCP server for Godot 4.x game engine",
  "main": "dist/index.js",
  "bin": {
    "godot-universal-mcp": "dist/cli/index.js",
    "gumcp": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:bridge": "node --test tests/client.test.cjs",
    "dev": "ts-node src/cli/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["godot", "mcp", "game-dev", "ai", "typescript"],
  "author": "Paul Schindler-Saefkow",
  "license": "MIT",
  "files": ["dist", "addons", "README.md", "docs/BRIDGE_GUIDE.md", "LICENSE", "NOTICE.md"],
  "engines": {"node": ">=20.0.0"},
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "commander": "^12.0.0",
    "pino": "^9.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
